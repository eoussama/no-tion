# Secret used to sign session tokens (at least 32 characters, e.g. `openssl rand -hex 32`)
NUXT_SECRET=your_secret_here

# Login password
NUXT_PASSWORD=your_password_here

# Notion's API key
NUXT_NOTION_API_KEY=your_notion_api_key_here

# TMDB API key (v3 key or v4 read token), powers the movie/TV lookup on the Cinema & TV form.
# Get one at https://www.themoviedb.org/settings/api. Leave empty to disable the lookup (manual entry still works).
NUXT_TMDB_API_KEY=
